<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MeadowPeaks</AssemblyName>
    <Version>2.5.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/MeadowPeaks.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../web/*.mjs;../web/index.html;../web/*.css;../web/icon.svg" LogicalName="MeadowPeaks.Web/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../web/assets/**/*" LogicalName="MeadowPeaks.Web/assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../artifacts/webview-runtime.cab" Link="WebViewRuntime.cab" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../artifacts/webview-runtime.cab')" />
    <EmbeddedResource Include="../web/assets/adventure-village.png" LogicalName="MeadowPeaks.AdventureVillage.png" />
    <EmbeddedResource Include="../web/assets/story-meadow.png" LogicalName="MeadowPeaks.StoryMeadow.png" />
    <Compile Remove="MeadowPeaks.Core/**/*.cs" />
    <ProjectReference Include="MeadowPeaks.Core/MeadowPeaks.Core.csproj" />
    <None Include="../LICENSE" Link="GAME-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/WebView2-SDK-LICENSE.txt" TargetPath="WebView2-SDK-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/WebView2-SDK-NOTICE.txt" TargetPath="WebView2-SDK-NOTICE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/Runtime-LICENSE.txt" TargetPath="Runtime-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/Runtime-ThirdPartyNotices.txt" TargetPath="Runtime-ThirdPartyNotices.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <Target Name="RemoveUnusedWebViewWpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup>
  </Target>
  <Target Name="RequirePortableRenderer" BeforeTargets="Publish">
    <Error Condition="!Exists('../artifacts/webview-runtime.cab')" Text="Run scripts/prepare_webview_runtime.ps1 before publishing the portable game." />
  </Target>
</Project>
